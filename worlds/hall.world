<?xml version="1.0"?>
<!-- Gazebo Classic 11 / ROS1 Noetic: exhibition hall + invisible LiDAR ceiling.
     Robot is spawned separately by launch/hall_with_t800.launch.
     Do not change the tested hall mesh transform or scale below.
-->
<sdf version="1.6">
  <world name="hall_world">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>false</shadows>
      <!-- Gazebo GUI grid: visual reference only, no collision. -->
      <grid>true</grid>
    </scene>

    <!-- ========================================================= -->
    <!-- INITIAL GAZEBO GUI CAMERA (WORLD frame)                    -->
    <!-- pose = x y z roll pitch yaw (m / radians)                 -->
    <!-- Example: above the south side of the hall, looking north -->
    <!-- Rotate yaw to change direction; increase pitch to look   -->
    <!-- further downward. Camera does NOT affect robot sensors.  -->
    <!-- ========================================================= -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -26 17 0 0.52 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- HALL: keep the previously validated pose, mesh and scale. -->
    <model name="hall">
      <static>true</static>
      <!-- x y z roll pitch yaw, measured in Gazebo WORLD -->
      <pose>-14.5715 12.9 0 1.57079632679 0 0</pose>
      <link name="hall_link">
        <gravity>false</gravity>
        <visual name="hall_visual">
          <geometry>
            <mesh>
              <uri>file:///root/catkin_ws/src/t800_description/meshes/hall.dae</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
        </visual>
        <collision name="hall_collision">
          <geometry>
            <mesh>
              <uri>file:///root/catkin_ws/src/t800_description/meshes/hall.dae</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- LiDAR ceiling: ONLY collision, deliberately invisible. -->
    <model name="lidar_ceiling">
      <static>true</static>
      <!-- Ceiling box CENTER pose: x y z roll pitch yaw -->
      <pose>0 0 4.0 0 0 0</pose>
      <link name="ceiling_link">
        <gravity>false</gravity>
        <collision name="ceiling_collision">
          <geometry>
            <box>
              <!-- x-size y-size thickness, in metres -->
              <size>30.0 28.0 0.02</size>
            </box>
          </geometry>
        </collision>
        <!-- NO visual: camera can see T800 through ceiling. -->
      </link>
    </model>
    
    <!-- LiDAR floor: ONLY collision, deliberately invisible. -->
    <model name="lidar_floor">
      <static>true</static>
      <!-- Ceiling box CENTER pose: x y z roll pitch yaw -->
      <pose>0 0 -0.03 0 0 0</pose>
      <link name="floor_link">
        <gravity>false</gravity>
        <collision name="floor_collision">
          <geometry>
            <box>
              <!-- x-size y-size thickness, in metres -->
              <size>30.0 28.0 0.02</size>
            </box>
          </geometry>
        </collision>
        <!-- NO visual: camera can see T800 through ceiling. -->
      </link>
    </model>

    <!-- No extra ground_plane: hall.dae has its own collision mesh. -->
  </world>
</sdf>
