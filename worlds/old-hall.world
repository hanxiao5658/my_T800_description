<?xml version="1.0"?>
<!--
  T800 hall scene for Gazebo Classic / ROS1 Noetic.
  Only the exhibition hall is loaded. No T800 URDF is spawned.
  Requires: t800_description/meshes/hall.dae
-->
<sdf version="1.6">
  <world name="hall_world">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>false</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <!--
      Hall model pose relative to Gazebo world frame.
      pose = X Y Z Roll Pitch Yaw
      Translation: meters; angles: radians.
      Modify this ONE line to place and orient the entire hall.
    -->
    <model name="hall">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="hall_link">
        <gravity>false</gravity>

        <visual name="hall_visual">
          <geometry>
            <mesh>
              <uri>model://t800_description/meshes/hall.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>

        <!--
          Use the SAME mesh for collision and visualization.
          Static triangle-mesh collision enables ray-based lidar
          simulation to perceive hall walls, floor, and fixtures
          represented as geometry in hall.dae.
        -->
        <collision name="hall_collision">
          <geometry>
            <mesh>
              <uri>model://t800_description/meshes/hall.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- No ground_plane: avoids coincident surfaces if hall.dae has a floor. -->
    <!-- No robot URDF or robot-spawning plugins. -->
  </world>
</sdf>
