<?xml version="1.0"?>
<sdf version="1.6">
  <world name="hall_world">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.7 0.7 0.7 1.0</background>
      <shadows>false</shadows>
    </scene>
    <include><uri>model://sun</uri></include>
    <model name="hall">
      <static>true</static>
      <!-- x y z roll pitch yaw (m, rad).
           Mesh coordinates resemble millimeters; mesh Y is vertical despite
           COLLADA reporting Z_UP. Roll=+90deg is a testable starting guess.
           -14.5715, +12.9 centers a ~29.143m x ~25.8m hall after rotation. -->
      <pose>-14.5715 12.9 0 1.57079632679 0 0</pose>
      <link name="hall_link">
        <gravity>false</gravity>
        <visual name="hall_visual">
          <geometry><mesh>
            <uri>file:///root/catkin_ws/src/t800_description/meshes/hall.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh></geometry>
        </visual>
        <collision name="hall_collision">
          <geometry><mesh>
            <uri>file:///root/catkin_ws/src/t800_description/meshes/hall.dae</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
